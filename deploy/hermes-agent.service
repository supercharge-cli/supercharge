[Unit]
Description=Hermes Agent Alternative
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes-agent-alternative
EnvironmentFile=/etc/hermes-agent/hermes-agent.env
ExecStart=/opt/hermes-agent-alternative/.venv/bin/uvicorn agent.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hermes-agent-alternative/runtime

[Install]
WantedBy=multi-user.target
