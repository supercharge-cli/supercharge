# Persistent daemon
SUPERAGENT_API_TOKEN=replace-with-a-long-random-token
SUPERAGENT_BIND=0.0.0.0:8787

# Durable state; persist this directory across restarts and container replacement.
SUPERAGENT_JOB_STATE=/var/lib/superagent/jobs.json
SUPERAGENT_MEMORY_STATE=/var/lib/superagent/memory.json
SUPERAGENT_GATEWAY_STATE=/var/lib/superagent/gateway-state.json
MATRIX_SYNC_STATE=/var/lib/superagent/matrix-sync.json

# E2B sandbox execution
E2B_API_KEY=replace-with-e2b-api-key

# Grok headless bridge and model provider.
# XAI_API_KEY is consumed by the upstream grok-build runtime; keep it in the host secret store.
XAI_API_KEY=
GROK_DEFAULT_MODEL=
GROK_CONFIG_PATH=/var/lib/superagent/grok-config.toml
# Leave GROK_AGENT_BINARY unset to run transport-only mode.
GROK_AGENT_BINARY=/usr/local/bin/xai-grok-pager-bin

# Telegram long polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_ECHO_MODE=false
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Discord Gateway
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_CHANNELS=
DISCORD_API_BASE_URL=https://discord.com/api/v10

# Slack Socket Mode
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USERS=
SLACK_ALLOWED_CHANNELS=
SLACK_API_BASE_URL=https://slack.com/api

# WhatsApp Business webhooks
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOWED_USERS=

# Signal REST / signal-cli-compatible service
SIGNAL_ACCOUNT=
SIGNAL_CLI_BASE_URL=http://127.0.0.1:8080
SIGNAL_ALLOWED_SENDERS=

# Matrix Client-Server sync
MATRIX_HOMESERVER=
MATRIX_ACCESS_TOKEN=
MATRIX_USER_ID=
MATRIX_ALLOWED_USERS=
MATRIX_ALLOWED_ROOMS=

# Generic authenticated webhook
GENERIC_WEBHOOK_SECRET=
GENERIC_WEBHOOK_ALLOWED_SOURCES=

# Optional MCP configuration as a JSON array of descriptors.
# SUPERAGENT_MCP_SERVERS=[]
