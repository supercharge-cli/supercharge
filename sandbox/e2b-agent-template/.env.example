# Supercharge E2B template (Vectra Cloud second runtime)
#
# After publishing, point the gateway at the template alias:
#   SUPERCHARGE_E2B_TEMPLATE=supercharge-full-sandbox
#
# Optional overrides for the publish script:
# SUPERCHARGE_E2B_TEMPLATE=supercharge-full-sandbox
# SUPERCHARGE_E2B_CPU_COUNT=16
# SUPERCHARGE_E2B_MEMORY_MB=16384
# E2B_API_KEY=
