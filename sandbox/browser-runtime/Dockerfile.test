FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm ca-certificates curl procps util-linux \
    xvfb x11vnc novnc websockify xauth x11-utils x11-xserver-utils \
    xfce4-session xfwm4 xfdesktop4 xfce4-panel xfce4-settings xfce4-terminal thunar \
    dbus-x11 xdotool wmctrl xclip xdg-utils libgtk-3-bin python3-pil python3-xlib \
    fonts-liberation fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji \
    libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libcups2t64 libdbus-1-3 \
    libdrm2 libgbm1 libgtk-3-0t64 libnspr4 libnss3 libx11-xcb1 libxcomposite1 libxdamage1 libxrandr2 \
    && rm -rf /var/lib/apt/lists/*
COPY package.json /opt/vectra/browser-runtime/package.json
RUN npm install --omit=dev --prefix /opt/vectra/browser-runtime && /opt/vectra/browser-runtime/node_modules/.bin/playwright install chromium
RUN usermod -l user -d /home/user -m ubuntu && mkdir -p /home/user/workspace && chown -R 1000:1000 /home/user
COPY . /opt/vectra/browser-runtime
USER user
ENV SUPERCHARGE_RUNTIME_MODE=e2b DISPLAY=:99 XAUTHORITY=/tmp/supercharge-browser/Xauthority DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/supercharge-browser/bus
WORKDIR /home/user/workspace
CMD ["bash", "-c", "bash /opt/vectra/browser-runtime/start.sh && exec sleep infinity"]
